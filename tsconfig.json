{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "sourceMap": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node", "vinext"],
    "target": "es2020"
  },
  "exclude": ["node_modules", "projects/**/*"]
}
